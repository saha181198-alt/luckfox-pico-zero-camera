#!/bin/sh

PROGRAM=/usr/bin/camera-display
PIDFILE=/var/run/camera-display.pid
LOGFILE=/var/log/camera-display.log

start_service() {
    if [ -r "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "camera-display is already running"
        return 0
    fi

    mkdir -p /var/run /var/log
    : >"$LOGFILE"
    echo "Starting camera-display"
    start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- \
        -c "exec '$PROGRAM' >>'$LOGFILE' 2>&1"
}

stop_service() {
    echo "Stopping camera-display"
    start-stop-daemon -K -p "$PIDFILE" 2>/dev/null || true
    rm -f "$PIDFILE"
}

case "${1:-}" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart)
        stop_service
        sleep 1
        start_service
        ;;
    status)
        if [ -r "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "camera-display is running (PID $(cat "$PIDFILE"))"
        else
            echo "camera-display is stopped"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac
