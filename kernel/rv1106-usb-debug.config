# Optional USB-enumeration diagnostics for the pinned Luckfox Linux 5.10 SDK.
# Apply after rv1106-camera-st7735.config. Enable diagnostic output at runtime
# through dynamic_debug/control and tracefs; this does not change USB roles.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=18
CONFIG_PROC_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_DYNAMIC_DEBUG=y

# FTRACE only opens the tracing menu. This visible option selects TRACING,
# EVENT_TRACING, TRACEPOINTS and the ring buffer without function tracing.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
# CONFIG_TRACEFS_DISABLE_AUTOMOUNT is not set
